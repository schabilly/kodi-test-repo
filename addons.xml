        <dir>
            <info compressed="false">https://raw.githubusercontent.com/schabilly/kodi-test-repo/main/addons.xml</info>
            <checksum>https://raw.githubusercontent.com/schabilly/kodi-test-repo/main/addons.xml.md5</checksum>
            <datadir zip="true">https://raw.githubusercontent.com/schabilly/kodi-test-repo/main/</datadir>
        </dir>
