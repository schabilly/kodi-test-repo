    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
    </requires>
    <extension point="xbmc.python.script" library="default.py"/>
    <extension point="xbmc.addon.metadata">
        <summary lang="en_GB">Test dummy addon</summary>
        <description lang="en_GB">Minimal addon for integration testing. Safe to install and remove.</description>
        <platform>all</platform>
